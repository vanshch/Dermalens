# Server
PORT=3000
CORS_ORIGIN=http://localhost:5173
# MongoDB
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/dermalens
# Auth
JWT_SECRET=your-secure-random-string-here
# Optional Gemini comparison. Set both to send uploaded images to Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=
# Email (Gmail App Password)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-16-char-app-password
